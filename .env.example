# ============================================================
# 医药研发知识助手 - 环境配置示例
# 复制为 .env 后填入真实 Key；不要把 .env 提交到 Git
# ============================================================

APP_NAME=医药研发知识助手
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# ===== 生成模型：智谱 GLM =====
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash
LLM_FALLBACK_MODEL=glm-4.5-flash
# 智谱文档说明 temperature=0 不适用，必须落在 (0, 1]
LLM_TEMPERATURE=0.1
LLM_JSON_MODE=true
LLM_THINKING=disabled
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=2
LLM_MAX_TOKENS=4096

# ===== Embedding：硅基流动 BGE-M3 =====
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3

# ===== Rerank：硅基流动（可选，默认关闭） =====
# 开启后混合检索会用 BGE reranker 重排 Top-N；无 Key 时自动回退 RRF
RERANK_ENABLED=true
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=20
RERANK_TIMEOUT=60

# ===== 路径（相对项目根目录） =====
DATA_DIR=data
CHROMA_DIR=storage/chroma
CHROMA_COLLECTION=pharma_research
SQLITE_PATH=storage/app.db
SNAPSHOT_DIR=storage/snapshots
LOG_DIR=storage/logs

# ===== 切块与检索 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TABLE_CHUNK_SIZE=1200
CHUNKER_VERSION=scientific-v1
ENABLE_ENTITY_LINKER=true
RETRIEVAL_K=20
MAX_CONTEXT_CHUNKS=8
# 初始阈值基于 P2 冒烟集校准；P8 评估集上必须重新校准。
MAX_DISTANCE=0.42
INDEX_BATCH_SIZE=64
EMBEDDING_TIMEOUT=120
HNSW_BATCH_SIZE=1000
HNSW_SYNC_THRESHOLD=100000
RRF_K=60
HYBRID_CANDIDATE_K=20

# ===== LangGraph 预算与停止条件 =====
MAX_PLAN_ROUNDS=2
MAX_SUBQUESTIONS=5
MAX_RETRIEVALS=12
MAX_TOOL_CALLS=4
MAX_LLM_CALLS=12
MAX_TASK_SECONDS=180
MAX_EVIDENCE=40

# ===== 演示身份 =====
DEMO_USER_HEADER=X-User-Id
DEFAULT_DEMO_USER=scientist_031
